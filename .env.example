# ==============================================================================
# TVK UTTAR PRADESH — SUPABASE + HOSTINGER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE DATABASE CONNECTION STRINGS
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# DATABASE_URL (Transaction Pooler - Port 6543 with ?pgbouncer=true):
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Direct Connection - Port 5432 for Prisma migrations):
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. PUBLIC APPLICATION DOMAIN
NEXT_PUBLIC_APP_URL="https://skyblue-tarsier-268054.hostingersite.com"

# 3. AUTHENTICATION & SECURITY KEYS
SESSION_SECRET="tvk_up_super_secret_session_key_2026_prod"
ENCRYPTION_KEY="tvk_up_super_secret_aes_encryption_key_2026"
QR_SECRET="tvk_up_super_secret_qr_verification_key"

# 4. SERVICES & SYSTEM RUNTIME
OTP_PROVIDER="development"
NODE_ENV="production"
